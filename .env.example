# ---- Server (apps/server) ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# SQLite file and processed-image folder (created automatically)
DATABASE_PATH=./data/app.db
MEDIA_DIR=./data/media

# Used to decide when "today" starts for the per-guest daily limit
APP_TIMEZONE=Asia/Kolkata

# Secret used to hash QR access tokens. REQUIRED (min 16 chars) in production.
TOKEN_PEPPER=change-me-to-a-long-random-string

# Public https origin guests use (printed by the token script). Example: https://photos.example.com
PUBLIC_URL=http://localhost:5173

# Dev convenience: a fixed token that always works. Ignored when NODE_ENV=production.
DEV_TOKEN=dev-token-1234

MAX_UPLOAD_MB=15
# true when behind Cloudflare Tunnel / Caddy so rate limits use the real client IP
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
